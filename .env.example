# Complete inference URLs. Endpoint defaults for JEV and OpenAI are shown below.
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
# TYPESAFE_API_KEY is accepted as an alternative to JEV_API_KEY.
JEV_MODEL=jev-1.13.0
JEV_NAME=JEV / TypeSafe

OPENAI_ENDPOINT=https://api.openai.com/v1/decisions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_NAME=OpenAI Decisions

# Use the resource endpoint from your Foundry deployment, then append this path.
# Model must be YOUR DEPLOYMENT NAME for Microsoft-Decision-1.
AZURE_ENDPOINT=
# Example: https://YOUR-RESOURCE.services.ai.azure.com/providers/microsoft/v1/systemone
AZURE_API_KEY=
AZURE_MODEL=
AZURE_NAME=Microsoft Decision

# Optional USD pricing overrides for the selected model/deployment, per 1M tokens.
# Set BOTH rates for a provider; blank values use the verified decision API list price.
# Use overrides for negotiated rates, regional/long-context premiums, or new models.
JEV_INPUT_USD_PER_MILLION=
JEV_OUTPUT_USD_PER_MILLION=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
AZURE_INPUT_USD_PER_MILLION=
AZURE_OUTPUT_USD_PER_MILLION=

